TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# 默认模型（留空则自动使用第一个拉取到的模型）
DEFAULT_MODEL=

# 提供商配置（JSON 格式）
# api_type: "openai" 或 "anthropic"
# models: 留空则自动从 /v1/models 接口拉取
PROVIDERS='[{"name":"ilaoxia-openai","api_type":"openai","base_url":"https://ai.ilaoxia.cn/v1","api_key":"sk-xxx","models":[]},{"name":"ilaoxia-anthropic","api_type":"anthropic","base_url":"https://ai.ilaoxia.cn","api_key":"sk-xxx","models":[]}]'

# 可选：限制允许使用的 Telegram 用户 ID（逗号分隔）
ALLOWED_USER_IDS=

# 数据库路径
DB_PATH=/data/bot.db

# 流式输出更新间隔（秒）
STREAM_UPDATE_INTERVAL=1.0
